<% layout('/layouts/boilerplate.ejs') %>
<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup</h1>
        <div class="col-6 offset-3">
 <form action="/signup" method="POST" novalidate class="needs-validation" novalidate>
                <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input name="username" id="username" type="text" class="form-control" required>
                        <div class="valid-feedback">Looks good!</div>
                </div>
                <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input name="email" id="email" type="text" class="form-control" required>
                </div> 
                <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input name="password" id="password" class="form-control" type="password" required>
                </div>
                <button class="btn btn-success mb-3">Signup</button>
        </div>
</div>